# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://notes:change-me-local-only@localhost:5432/notes

# Used by docker-compose.yml for the local PostgreSQL 16 container.
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=notes
VITE_API_URL=http://localhost:3000

# Auth. JWT_SECRET must be at least 32 characters; generate one with `openssl rand -base64 48`.
JWT_SECRET=change-me-local-only-use-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Auth rate limits (per IP and per normalized email). Values below are the defaults.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT_MAX=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
# Password reset. OTP_SECRET must be at least 32 characters and is the HMAC key that protects
# stored OTPs; it must not contain the `change-me` placeholder when NODE_ENV=production.
# The OTP is written to the server console only when NODE_ENV=development.
OTP_SECRET=change-me-local-only-otp-secret-use-a-long-random-string
# Reset rate limits (per IP and per normalized email). Values below are the defaults.
RESET_REQUEST_RATE_LIMIT_MAX=5
RESET_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
RESET_CONFIRM_RATE_LIMIT_MAX=10
RESET_CONFIRM_RATE_LIMIT_WINDOW_SECONDS=900
# Note writes (POST/PATCH /api/notes), per IP and per user. Values below are the defaults.
NOTE_WRITE_RATE_LIMIT_MAX=60
NOTE_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
