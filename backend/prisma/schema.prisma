// Schema changes go through Prisma migrations only.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String
  emailNormalized String   @unique
  passwordHash    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokenSessions    RefreshTokenSession[]
  passwordResetChallenges PasswordResetChallenge[]
  notes                   Note[]
  tags                    Tag[]
}

model RefreshTokenSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  otpHmac       String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @db.Uuid
  title      String
  content    Json
  searchText String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  owner      User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions   NoteVersion[]
  noteTags   NoteTag[]
  shareLinks ShareLink[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc), id])
  @@index([ownerId, deletedAt, createdAt(sort: Desc), id])
}

model NoteVersion {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @db.Uuid
  title     String
  content   Json
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @db.Uuid
  name           String
  nameNormalized String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  noteTags NoteTag[]

  @@unique([ownerId, nameNormalized])
  @@index([ownerId])
}

model NoteTag {
  noteId    String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
}

model ShareLink {
  id        String    @id @default(uuid()) @db.Uuid
  noteId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  note  Note        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  views ShareView[]

  @@index([noteId, createdAt])
}

model ShareView {
  shareLinkId String   @db.Uuid
  viewerHash  String
  countedAt   DateTime

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@id([shareLinkId, viewerHash])
}
