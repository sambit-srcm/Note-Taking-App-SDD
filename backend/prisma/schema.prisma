// Schema changes go through Prisma migrations only.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String
  emailNormalized String   @unique
  passwordHash    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refreshTokenSessions    RefreshTokenSession[]
  passwordResetChallenges PasswordResetChallenge[]
  notes                   Note[]
}

model RefreshTokenSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  otpHmac       String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Note {
  id         String    @id @default(uuid()) @db.Uuid
  ownerId    String    @db.Uuid
  title      String
  content    Json
  searchText String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  owner    User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions NoteVersion[]

  @@index([ownerId, deletedAt, updatedAt(sort: Desc), id])
}

model NoteVersion {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @db.Uuid
  title     String
  content   Json
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
}
