{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:check": "tsx --env-file-if-exists=../.env scripts/db-check.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1"
  },
  "dependencies": {
    "@notes/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
