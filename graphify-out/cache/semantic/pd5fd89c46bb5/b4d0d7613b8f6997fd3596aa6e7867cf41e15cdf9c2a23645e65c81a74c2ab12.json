{"nodes": [{"id": "backend_claude_express_api", "label": "Express 5 API", "file_type": "concept", "source_file": "backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend-only rules on top of root CLAUDE.md and AGENTS.md. Intended pnpm filter scripts exist, but package.json must be confirmed before they are run."}, {"id": "backend_claude_request_layers", "label": "Backend Request Layers", "file_type": "rationale", "source_file": "backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes, then auth and rate-limit middleware, then Zod validation from @notes/shared, then a service, then Prisma. Routes only parse, call one service, and shape the response."}, {"id": "backend_claude_owner_scoped_queries", "label": "Owner-Scoped Queries", "file_type": "rationale", "source_file": "backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every private query puts ownerId = req.user.id in the where clause. Fetch-then-check is not enough, and userId or ownerId from the body or params is never trusted."}, {"id": "backend_claude_central_error_handler", "label": "Central Error Handler", "file_type": "rationale", "source_file": "backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes throw typed app errors. One handler maps them to the AGENTS.md error shape and adds requestId. Express 5 forwards async rejections, so routes do not add try/catch wrappers."}, {"id": "backend_claude_version_transactions", "label": "Note Version Transactions", "file_type": "rationale", "source_file": "backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "prisma.$transaction wraps create-plus-snapshot, update-plus-snapshot, and restore. Identical consecutive versions are deduped inside that same transaction."}, {"id": "backend_claude_public_share_router", "label": "Public Share Router", "file_type": "rationale", "source_file": "backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The public share route is a separate router with a narrow response DTO. It never reuses the owner note DTO."}, {"id": "backend_claude_cleanup_job", "label": "Idempotent Cleanup Job", "file_type": "rationale", "source_file": "backend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The cleanup job must be idempotent and safe to run twice. Notes are not hard-deleted before the 30-day window."}], "edges": [{"source": "backend_claude_express_api", "target": "agents_source_of_truth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_express_api", "target": "claude_permission_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_request_layers", "target": "packages_shared_claude_shared_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_central_error_handler", "target": "agents_error_shape", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_owner_scoped_queries", "target": "agents_cross_user_concealment", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_version_transactions", "target": "agents_note_version_transactions", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_public_share_router", "target": "agents_share_links", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_cleanup_job", "target": "agents_soft_delete", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_request_layers", "target": "agents_request_flow", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "backend_claude_request_layers", "target": "agents_business_logic_in_services", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "backend/CLAUDE.md", "source_location": null, "weight": 1.0}], "hyperedges": []}