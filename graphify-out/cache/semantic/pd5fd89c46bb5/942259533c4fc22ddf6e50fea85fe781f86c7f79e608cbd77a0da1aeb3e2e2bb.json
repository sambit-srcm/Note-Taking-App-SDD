{"nodes": [{"id": "docs_tickets_ab_1004_note_crud_soft_delete", "label": "AB-1004 Note CRUD and Soft Delete", "file_type": "document", "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest-priority story for authenticated create, read, update, soft delete, trash listing, and restore, with strict content validation and transactional version snapshots. Depends on AB-1001, AB-1002, the Note and NoteVersion schema, the note API contract, and the content-validation policy. Editor UI, search, tags, sharing, history UI, and physical deletion during recovery are out of scope."}, {"id": "docs_tickets_ab_1004_note_crud_soft_delete_note_crud", "label": "Note CRUD", "file_type": "concept", "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The owner can create and retrieve a valid note. Paths and payloads follow the approved API contract and are not invented in the ticket. Required search-data maintenance rides along with note writes so later search does not rebuild content from scratch."}, {"id": "docs_tickets_ab_1004_note_crud_soft_delete_tiptap_validation", "label": "TipTap Validation", "file_type": "concept", "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approved Decision 1: title max 200 Unicode code points after trim, whitespace-only titles rejected, canonical TipTap JSON, empty valid documents allowed, 1,048,576 UTF-8 bytes, depth 20 with root at zero, 10,000 nodes, and only approved nodes, marks, attributes, and nesting. Shared schemas live in packages/shared. Backend validation is authoritative. Invalid or oversized content is rejected without persistence and is never silently truncated. Title limits count supplementary characters as code points."}, {"id": "docs_tickets_ab_1004_note_crud_soft_delete_version_snapshot", "label": "Version Snapshot Transaction", "file_type": "concept", "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The note and its initial snapshot either both persist or neither does. A qualifying update and its snapshot commit atomically. An unchanged update does not create a duplicate consecutive snapshot. A failed update leaves the note and its history unchanged."}, {"id": "docs_tickets_ab_1004_note_crud_soft_delete_soft_delete", "label": "Soft Delete", "file_type": "concept", "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "deletedAt marks trash and removes the note from normal access. The owner can list and restore eligible trashed notes. The 30-day recovery window is preserved, and notes are not physically deleted during it."}, {"id": "docs_tickets_ab_1004_note_crud_soft_delete_ownership", "label": "Note Ownership", "file_type": "concept", "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every private note operation checks ownership. A user cannot access or modify another user's notes."}], "edges": [{"source": "docs_tickets_ab_1004_note_crud_soft_delete", "target": "docs_tickets_ab_1001_project_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete", "target": "docs_tickets_ab_1002_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete", "target": "docs_tickets_ab_1005_pagination_sorting_tag_filters", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_note_crud", "target": "docs_tickets_ab_1004_note_crud_soft_delete_tiptap_validation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_note_crud", "target": "docs_tickets_ab_1004_note_crud_soft_delete_soft_delete", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_note_crud", "target": "docs_tickets_ab_1004_note_crud_soft_delete_ownership", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_version_snapshot", "target": "docs_tickets_ab_1004_note_crud_soft_delete_note_crud", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_tiptap_validation", "target": "docs_frs_tiptap_json", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_soft_delete", "target": "docs_frs_trash", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_version_snapshot", "target": "docs_sds_note_version_transactions", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete_ownership", "target": "docs_frs_ownership", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1004_note_crud_soft_delete", "target": "docs_frs_note", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1004-note-crud-soft-delete.md", "source_location": null, "weight": 1.0}], "hyperedges": []}