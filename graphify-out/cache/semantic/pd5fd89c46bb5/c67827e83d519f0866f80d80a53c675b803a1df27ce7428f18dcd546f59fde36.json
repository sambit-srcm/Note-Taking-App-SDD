{"nodes": [{"id": "docs_tickets_ab_1005_pagination_sorting_tag_filters", "label": "AB-1005 Pagination Sorting and Tag Filters", "file_type": "document", "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-priority story for a paginated, stably sorted note list with selected-tag filtering. Depends on AB-1001, AB-1002, AB-1004, and AB-1006 for the tag association contract. Tag CRUD, search, the notes-list UI, and unrelated CRUD changes are out of scope. Ticket numbering does not override dependencies."}, {"id": "docs_tickets_ab_1005_pagination_sorting_tag_filters_pagination", "label": "Note Pagination", "file_type": "concept", "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended defaults, pending approval: page size 20, maximum 100. Omitted page size uses the default. Oversized page size follows the approved reject-or-normalize policy. Invalid pagination returns the agreed error. Ownership and deletion filters apply before pagination so other users' notes and trash never fill a page. Pagination can be built before tag filtering is finished."}, {"id": "docs_tickets_ab_1005_pagination_sorting_tag_filters_stable_ordering", "label": "Stable Note Ordering", "file_type": "concept", "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default order is updatedAt descending, then id as the tie-breaker. Only approved sort fields and directions are allowed. The tie-breaker exists so pagination does not duplicate or skip rows when timestamps collide."}, {"id": "docs_tickets_ab_1005_pagination_sorting_tag_filters_tag_filter", "label": "Tag Filter", "file_type": "concept", "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended multi-tag semantics are AND: every selected tag must match. An empty tag filter returns the normal unfiltered list. Filtering and pagination work together. Completion waits on AB-1006's Tag and NoteTag association behavior. Queries should avoid N+1 access and add indexes from the real query shape. Shared Zod schemas stay synchronized with the API contract."}, {"id": "docs_tickets_ab_1005_pagination_sorting_tag_filters_ownership_trash", "label": "List Ownership and Trash Exclusion", "file_type": "concept", "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the authenticated user's notes are returned, and trashed notes are excluded by default. Those filters run before pagination so page boundaries describe the caller's visible set."}, {"id": "docs_tickets_ab_1005_pagination_sorting_tag_filters_ab_1006_tag_model", "label": "AB-1006 Tag Model", "file_type": "concept", "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tag filtering uses the approved Tag and NoteTag model from AB-1006. Pagination and sorting can proceed without that schema, but tag filtering cannot be completed until AB-1006 supplies the association behavior. Ticket numbering does not override that dependency."}], "edges": [{"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters", "target": "docs_tickets_ab_1001_project_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters", "target": "docs_tickets_ab_1002_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters", "target": "docs_tickets_ab_1004_note_crud_soft_delete", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_tag_filter", "target": "docs_tickets_ab_1005_pagination_sorting_tag_filters_ab_1006_tag_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_pagination", "target": "docs_tickets_ab_1005_pagination_sorting_tag_filters_stable_ordering", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_pagination", "target": "docs_tickets_ab_1005_pagination_sorting_tag_filters_tag_filter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_pagination", "target": "docs_tickets_ab_1005_pagination_sorting_tag_filters_ownership_trash", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_stable_ordering", "target": "docs_tickets_ab_1005_pagination_sorting_tag_filters_pagination", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_ownership_trash", "target": "docs_frs_ownership", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_ownership_trash", "target": "docs_frs_trash", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_tag_filter", "target": "docs_sds_note_tag", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters_ab_1006_tag_model", "target": "docs_sds_tag", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1005_pagination_sorting_tag_filters", "target": "docs_frs_pagination", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1005-pagination-sorting-tag-filters.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_