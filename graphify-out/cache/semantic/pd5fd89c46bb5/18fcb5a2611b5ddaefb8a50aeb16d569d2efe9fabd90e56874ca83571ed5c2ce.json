{"nodes": [{"id": "frontend_claude_react_app", "label": "React 19 Vite App", "file_type": "concept", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Function components and hooks only, one named export per file, shadcn/ui primitives first, and feature folders for notes, auth, and similar areas."}, {"id": "frontend_claude_api_client", "label": "Single API Client", "file_type": "rationale", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All HTTP goes through one API client that attaches the access token and on 401 refreshes once and retries, otherwise logs out. Components must not call fetch or axios directly."}, {"id": "frontend_claude_tanstack_query", "label": "TanStack Query Server State", "file_type": "concept", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes, tags, search, versions, and shares live in TanStack Query with query-key factories and invalidation on mutation."}, {"id": "frontend_claude_zustand", "label": "Zustand Client State", "file_type": "concept", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zustand holds only transient UI such as the tag filter, sidebar, and editor draft status. Server data is never copied into Zustand."}, {"id": "frontend_claude_tiptap_allowlist", "label": "TipTap Allowlist Match", "file_type": "rationale", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Editor extensions must match the shared content allowlist exactly. Note content is rendered through the editor or a safe renderer, never dangerouslySetInnerHTML."}, {"id": "frontend_claude_access_token_memory", "label": "In-Memory Access Token", "file_type": "rationale", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The access token lives in memory, not localStorage. Refresh-token storage is an open decision, so the client must not pick a transport on its own."}, {"id": "frontend_claude_autosave", "label": "Debounced Autosave", "file_type": "rationale", "source_file": "frontend/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Autosave is debounced and shows saving, saved, or failed. On failure the local draft is kept and retry is offered so unsaved content is never discarded."}], "edges": [{"source": "frontend_claude_react_app", "target": "agents_source_of_truth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "frontend_claude_react_app", "target": "claude_permission_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "frontend_claude_api_client", "target": "packages_shared_claude_shared_contracts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "frontend_claude_tiptap_allowlist", "target": "packages_shared_claude_content_module", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "frontend/CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "frontend_claude_tiptap_allowlist", "target": "agents_tiptap_content_rules", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_fil