{"nodes": [{"id": "openspec_changes_api_contract_open_decisions_document", "label": "API Contract Open Decisions", "file_type": "document", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needed before delta-openapi.yaml can be approved. Nothing here is decided by FRS or SDS. Ruby YAML parsed 18 paths and 26 operations, all x-proposed, but the file is not verified against the OpenAPI 3.0.3 schema."}, {"id": "openspec_changes_api_contract_open_decisions_routes_proposed", "label": "OPEN-0 Proposed Routes", "file_type": "rationale", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FRS and SDS define no paths, methods, or field names. Every operation carries x-proposed true until approved or renamed. This is a plain draft because no spec command exists in the repo."}, {"id": "openspec_changes_api_contract_open_decisions_refresh_transport", "label": "OPEN-1 Refresh Token Transport", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON body is drafted versus an httpOnly cookie for FRS-AUTH-002 and FRS-AUTH-003. The choice affects CSRF and the client. Proposed P9 puts tokens in JSON under /auth and remains undecided."}, {"id": "openspec_changes_api_contract_open_decisions_view_counting", "label": "OPEN-2 View Counting", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Whether view counts happen inside GET /shared/{token} or a later client call is unspecified, as are anonymous-browser identity for 30-minute dedupe and bot exclusion."}, {"id": "openspec_changes_api_contract_open_decisions_share_link_cardinality", "label": "OPEN-3 One Share Link", "file_type": "rationale", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FRS says a share link. The draft allows one active link and returns 409 if one exists. Expiry uses expiresInDays from 1 to 30, default 7. Proposed P8 keeps the owner share resource separate from the public token path."}, {"id": "openspec_changes_api_contract_open_decisions_list_behavior", "label": "List Sort Pagination and Trash Draft", "file_type": "rationale", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OPEN-4 drafts sort by updatedAt, createdAt, or title plus order. OPEN-5 rejects invalid pagination with 422. OPEN-6 disallows editing a trashed note while the owner may still read it. OPEN-10 drafts UUID ids and page plus pageSize and total. OPEN-7 leaves empty-query and highlight format open."}, {"id": "openspec_changes_api_contract_open_decisions_registration_enumeration", "label": "OPEN-9 Registration Enumeration", "file_type": "rationale", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FRS-AUTH-001 requires 409 for duplicate emails, while FRS-AUTH-004 says avoid revealing registered emails. A 409 on register leaks existence. Proposed P11 makes password-reset request always return 204."}, {"id": "openspec_changes_api_contract_open_decisions_error_catalogue", "label": "OPEN-11 Error Code Catalogue", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SDS gives only VALIDATION_ERROR and optional fields. The error code catalogue and the fields item shape are undecided. SDS lists 403, but ownership failures are drafted as 404 concealment, so 403 is unused until confirmed. Status 413 has no numeric cap beyond 1 MiB plus a bounded envelope, and rate-limit thresholds are unspecified."}, {"id": "openspec_changes_api_contract_open_decisions_password_policy", "label": "OPEN-12 Password Policy", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FRS-AUTH-004 references an application password policy that neither FRS nor SDS defines."}, {"id": "openspec_changes_api_contract_open_decisions_tiptap_allowlist", "label": "OPEN-13 TipTap Allowlist", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The node, mark, and attribute allowlist must be fixed in packages/shared before validation can be specified. The OpenAPI schema stays intentionally loose until then."}, {"id": "openspec_changes_api_contract_open_decisions_tag_normalization", "label": "OPEN-14 Tag Normalization", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Case, maximum length, and the tag-count definition are open. The draft counts non-deleted notes only, following the FRS-TAG-001 text."}, {"id": "openspec_changes_api_contract_open_decisions_ownership_concealment", "label": "P10 Ownership 404 Concealment", "file_type": "rationale", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed, not approved. Ownership failures return 404 and never 403 because SDS section 4 allows concealment and that avoids existence leaks. P1 through P12 are proposed; defined FRS and SDS behavior is carried over rather than newly decided."}, {"id": "openspec_changes_api_contract_open_decisions_otp", "label": "OPEN-8 OTP Confirmation", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OTP format and length are unspecified. Invalid, expired, or exhausted OTP is drafted as 401, with 422 as the alternative. Confirmation is drafted as one step rather than verify-then-reset."}, {"id": "openspec_changes_api_contract_open_decisions_traceability", "label": "FRS Requirement Traceability", "file_type": "concept", "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every FRS requirement maps to at least one proposed operation, from register through version restore. Scheduled purge has no endpoint because it is a system job in SDS section 2."}], "edges": [{"source": "openspec_changes_api_contract_open_decisions_document", "target": "openspec_changes_api_contract_delta_openapi_note_taking_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_api_contract_open_decisions_routes_proposed", "target": "openspec_changes_api_contract_delta_openapi_note_taking_api", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/api-contract/OPEN_DECISIONS.md", "source_location": null, "weight": 1.0}, {"source": "ope