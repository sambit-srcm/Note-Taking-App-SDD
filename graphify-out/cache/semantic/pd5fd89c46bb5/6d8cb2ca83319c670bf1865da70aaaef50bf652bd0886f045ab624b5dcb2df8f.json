{"nodes": [{"id": "claude_permission_model", "label": "Ask Versus Proceed", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads, in-scope edits, and lint, typecheck, unit tests, and builds proceed without a prompt. Contract changes, open decisions, dependency changes, Prisma migrations, and edits to FRS, SDS, or Claude settings wait for an explicit yes. Secrets, .env files, --no-verify, and force-push of main are never allowed."}, {"id": "claude_quality_gates", "label": "Quality Gates", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stop at the first failure: pnpm lint including typecheck, pnpm test, pnpm build, then pnpm test:e2e only for user-flow changes and only with confirmation. Do not report done until the first three pass, and do not weaken a test or lint rule."}, {"id": "claude_context_management", "label": "Session Context Management", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Clear around 60k tokens after writing the task, decisions, and next step into notes or the OpenSpec change. One approved task per session, using the engineer, tester, and reviewer agents."}, {"id": "claude_thinking_depth", "label": "Thinking Depth", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Think hard for token rotation, ownership, transactions, validation limits, migrations, and anything touching the API contract. If the spec is silent or contradictory, stop and ask instead of inventing an answer."}, {"id": "claude_conventional_commits", "label": "Conventional Commits", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imperative conventional commits, subject at most 72 characters, one logical change, and a requirement id in the body when relevant. Commit only when asked. Never commit directly to main."}, {"id": "claude_one_task_per_branch", "label": "One Task Per Branch", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch names are type/short-kebab-description, optionally with a ticket id. One task per branch, and main is never committed to directly."}], "edges": [{"source": "claude_permission_model", "target": "agents_source_of_truth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_context_management", "target": "claude_agents_engineer_engineer_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_context_management", "target": "claude_agents_tester_test_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_context_management", "target": "claude_agents_reviewer_reviewer_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_quality_gates", "target": "claude_agents_reviewer_reviewer_agent", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CLAUDE.md", "source_location": null, "weight": 1.0}, {"source": "claude_thinking_depth", "target": "agents_jwt_auth", "relation": "references", "confiden