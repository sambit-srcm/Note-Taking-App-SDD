{"nodes": [{"id": "docs_tickets_ab_1002_authentication", "label": "AB-1002 Authentication", "file_type": "document", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest-priority story for registration, login, JWT access tokens, refresh rotation, and logout with database-backed sessions. Depends on AB-1001 and the approved authentication API contract and user/session schema. OTP reset, authentication UI, OAuth, admin roles, and note CRUD are out of scope. The API must match the approved OpenAPI contract."}, {"id": "docs_tickets_ab_1002_authentication_registration", "label": "Registration", "file_type": "concept", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registration stores a secure password hash. Duplicate normalized emails are rejected. Invalid requests use the agreed validation response. Database failures must not leave partial authentication records."}, {"id": "docs_tickets_ab_1002_authentication_email_normalization", "label": "Email Normalization", "file_type": "concept", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended policy, pending the approved rule: trim surrounding whitespace and lowercase for identity and uniqueness. Dots and plus aliases are kept so those addresses remain distinct users."}, {"id": "docs_tickets_ab_1002_authentication_jwt_access_token", "label": "JWT Access Token", "file_type": "concept", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access tokens live 15 minutes. Protected routes reject missing, malformed, and expired access tokens. Invalid credentials do not create a session. Credentials and raw tokens stay out of responses and logs."}, {"id": "docs_tickets_ab_1002_authentication_refresh_token_rotation", "label": "Refresh Token Rotation", "file_type": "concept", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refresh tokens live 7 days, are stored as hashes, and rotate on use, returning a new access token. Sessions track owner, expiry, and revocation. Logout revokes the applicable session. Rotated or revoked refresh tokens cannot be reused successfully."}, {"id": "docs_tickets_ab_1002_authentication_token_family_revocation", "label": "Token Family Revocation", "file_type": "concept", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended baseline: reuse of a rotated token revokes its token family and requires reauthentication, so theft of an already-used refresh token cannot mint a sibling session."}, {"id": "docs_tickets_ab_1002_authentication_middleware", "label": "Authentication Middleware", "file_type": "concept", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Middleware exposes the verified user identity to later handlers so each private route does not reimplement JWT checks."}, {"id": "docs_tickets_ab_1002_authentication_rate_limiting", "label": "Auth Rate Limiting", "file_type": "concept", "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registration, login, and refresh are rate limited so credential guessing and refresh storms are bounded before they reach password or token checks."}], "edges": [{"source": "docs_tickets_ab_1002_authentication", "target": "docs_tickets_ab_1001_project_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication", "target": "docs_tickets_ab_1003_otp_password_reset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_registration", "target": "docs_tickets_ab_1002_authentication_email_normalization", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_registration", "target": "docs_sds_user", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_jwt_access_token", "target": "docs_tickets_ab_1002_authentication_refresh_token_rotation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_jwt_access_token", "target": "docs_tickets_ab_1002_authentication_middleware", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_refresh_token_rotation", "target": "docs_tickets_ab_1002_authentication_token_family_revocation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_refresh_token_rotation", "target": "docs_sds_refresh_token_session", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_rate_limiting", "target": "docs_tickets_ab_1002_authentication_registration", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication", "target": "docs_frs_authentication", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1002_authentication_middleware", "target": "docs_frs_ownership", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/tickets/AB-1002-authentication.md", "source_location": null, "weight": 1.0}], "hyperedges": []}