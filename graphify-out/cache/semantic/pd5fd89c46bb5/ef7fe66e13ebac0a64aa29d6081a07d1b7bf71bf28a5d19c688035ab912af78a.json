{"nodes": [{"id": "docs_tickets_ab_1001_project_setup", "label": "AB-1001 Project Setup", "file_type": "document", "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest-priority technical story to establish a reproducible monorepo so later features share one toolchain. Authentication, note logic, tags, search, sharing, version history, production cloud deployment, and full CI/CD are out of scope. No prior ticket dependency."}, {"id": "docs_tickets_ab_1001_project_setup_monorepo", "label": "pnpm Monorepo", "file_type": "concept", "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pnpm workspaces split frontend, backend, and packages/shared. Node.js, pnpm, and dependencies are pinned, never @latest. TypeScript is strict. Root scripts cover build, lint, test, and development. Secrets stay out of source control."}, {"id": "docs_tickets_ab_1001_project_setup_packages_shared", "label": "Shared Package", "file_type": "concept", "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-app types and Zod schemas live only in packages/shared. Both applications must be able to import that package so contracts are not copied into each app."}, {"id": "docs_tickets_ab_1001_project_setup_health_endpoint", "label": "Health Endpoint", "file_type": "concept", "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A health endpoint returns the approved response and status so the scaffold can be checked before any business feature exists. It ships with tests."}, {"id": "docs_tickets_ab_1001_project_setup_environment_validation", "label": "Environment Validation", "file_type": "concept", "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing environment variables are reported safely, without committing secrets. An example environment file and setup docs cover prerequisites, environment, migrations, and commands."}, {"id": "docs_tickets_ab_1001_project_setup_prisma_postgresql", "label": "Prisma PostgreSQL Configuration", "file_type": "concept", "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prisma is configured for PostgreSQL 16 and must connect to the configured database before later tickets add domain models."}, {"id": "docs_tickets_ab_1001_project_setup_quality_gates", "label": "Setup Quality Gates", "file_type": "concept", "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Done means pnpm build, pnpm lint --max-warnings 0, and pnpm test pass, a sample automated test passes, and no secrets are committed. Vitest, Supertest, and Playwright are set up here even though product flows come later."}], "edges": [{"source": "docs_tickets_ab_1001_project_setup_monorepo", "target": "docs_tickets_ab_1001_project_setup_packages_shared", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1001_project_setup_monorepo", "target": "docs_tickets_ab_1001_project_setup_health_endpoint", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1001_project_setup_monorepo", "target": "docs_tickets_ab_1001_project_setup_environment_validation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1001_project_setup_monorepo", "target": "docs_tickets_ab_1001_project_setup_prisma_postgresql", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1001_project_setup_quality_gates", "target": "docs_tickets_ab_1001_project_setup_monorepo", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1001_project_setup_packages_shared", "target": "docs_sds_packages_shared", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1001_project_setup_prisma_postgresql", "target": "docs_sds_postgresql", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1001_project_setup", "target": "docs_frs_technology_constraints", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/tickets/AB-1001-project-setup.md", "source_location": null, "weight": 1.0}], "hyperedges": []}