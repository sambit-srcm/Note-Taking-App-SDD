{"nodes": [{"id": "openspec_changes_ab_1001_project_setup_proposal_proposal", "label": "AB-1001 Proposal", "file_type": "document", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repo holds only specs and tooling. AB-1001 is the foundation so later tickets have a reproducible pnpm monorepo and passing lint, test, and build. Nothing is breaking because there is no code yet."}, {"id": "openspec_changes_ab_1001_project_setup_proposal_monorepo_scaffold", "label": "Pinned pnpm Monorepo Scaffold", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a pnpm workspace with Node 22 and root scripts dev, build, lint, test, and test:e2e, plus a React 19 Vite frontend, an Express 5 backend, and a TypeScript plus Zod shared package. Dependencies are exact and need approval."}, {"id": "openspec_changes_ab_1001_project_setup_proposal_service_health", "label": "service-health Capability", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unauthenticated liveness endpoint with a fixed response. GET /api/health returns 200 and status ok, needs no auth, and makes no database call. It is added to the draft OpenAPI as x-proposed pending approval."}, {"id": "openspec_changes_ab_1001_project_setup_proposal_runtime_configuration", "label": "runtime-configuration Capability", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Startup validation of required environment variables reports missing or invalid names and never leaks secret values."}, {"id": "openspec_changes_ab_1001_project_setup_proposal_shared_contracts", "label": "Shared Health and Error Contracts", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both apps import HealthResponse and ErrorResponse from packages/shared as @notes/shared. No domain schemas yet. Strict TypeScript is enabled everywhere."}, {"id": "openspec_changes_ab_1001_project_setup_proposal_prisma_no_schema_change", "label": "Prisma Configured Without Migrations", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL 16 is configured with a generator and datasource only, no models and no migrations, plus docker-compose, .env.example, and a SELECT 1 connectivity check."}, {"id": "openspec_changes_ab_1001_project_setup_proposal_open_decisions_untouched", "label": "Open Decisions Left Unresolved", "file_type": "rationale", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "None of the 14 decisions in OPEN_DECISIONS.md is resolved. The health route is a new proposal added to that file for visibility. openspec/specs is empty, so no existing capability is modified."}, {"id": "openspec_changes_ab_1001_project_setup_proposal_out_of_scope", "label": "AB-1001 Out of Scope", "file_type": "rationale", "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authentication, note logic, tags, search, sharing, versions, production deployment, full CI/CD, and JWT or auth env vars belong to later tickets, starting with AB-1002. Domain schemas and Playwright journeys are also out of this change."}], "edges": [{"source": "openspec_changes_ab_1001_project_setup_proposal_service_health", "target": "openspec_changes_ab_1001_project_setup_specs_service_health_spec_delta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_ab_1001_project_setup_proposal_service_health", "target": "openspec_changes_api_contract_delta_openapi_note_taking_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_ab_1001_project_setup_proposal_runtime_configuration", "target": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_delta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_ab_1001_project_setup_proposal_open_decisions_untouched", "target": "openspec_changes_api_contract_open_decisions_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_ab_1001_project_setup_proposal_monorepo_scaffold", "target": "openspec_changes_ab_1001_project_setup_design_workspace_layout", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "openspec/changes/ab-1001-project-setup/proposal.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_ab_1001_project_setup_proposal_prisma_no_schema_change", "