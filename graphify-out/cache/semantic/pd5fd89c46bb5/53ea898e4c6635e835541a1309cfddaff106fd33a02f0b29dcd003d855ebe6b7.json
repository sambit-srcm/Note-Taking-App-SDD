{"nodes": [{"id": "openspec_changes_ab_1001_project_setup_tasks_tasks", "label": "AB-1001 Tasks", "file_type": "document", "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Workspace, shared package, and API scaffold tasks are done. Prisma connectivity, the web scaffold, root scripts, the contract update, and docs remain open. The reviewer runs before the PR, then the change is archived."}, {"id": "openspec_changes_ab_1001_project_setup_tasks_workspace_foundation", "label": "Workspace Foundation Tasks", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Root package.json, pnpm workspace, Node 22, save-exact, gitignore, strict tsconfig, ESLint flat config, and Prettier. The dependency list is approved before the first pnpm add. Lint is eslint with max-warnings 0 plus tsc --noEmit."}, {"id": "openspec_changes_ab_1001_project_setup_tasks_api_health", "label": "API Config and Health Tasks", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Express 5 createApp is separate from server.ts, with requestId, an SDS section 4 error handler, a safe 404 JSON body, parseEnv that never echoes values, GET /api/health without auth, shared imports, .env.example, and docker-compose Postgres 16."}, {"id": "openspec_changes_ab_1001_project_setup_tasks_prisma_connectivity", "label": "Prisma Connectivity Tasks", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "schema.prisma is a generator and PostgreSQL datasource only, with no migrations. SELECT 1 and test:db need approval to touch the local compose database and must not print credentials when the host is unreachable."}, {"id": "openspec_changes_ab_1001_project_setup_tasks_web_scaffold", "label": "Web Scaffold Tasks", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React 19 Vite frontend with a VITE_API_URL check, a shared import and Vitest test, and Playwright webServer wiring with a skipped placeholder listed by test:e2e --list."}, {"id": "openspec_changes_ab_1001_project_setup_tasks_contract_docs", "label": "Contract and Docs Tasks", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add GET /api/health to delta-openapi.yaml as x-proposed and a matching OPEN_DECISIONS entry, write setup docs, update AGENTS.md key commands, and finish with lint, test, build, and a git status that shows no .env."}, {"id": "openspec_changes_ab_1001_project_setup_tasks_review_archive", "label": "Reviewer Then Archive", "file_type": "rationale", "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run the reviewer agent against the diff and the AB-1001 acceptance criteria before the PR. Archive the change after review requirements are satisfied."}], "edges": [{"source": "openspec_changes_ab_1001_project_setup_tasks_api_health", "target": "openspec_changes_ab_1001_project_setup_specs_service_health_spec_liveness", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/ab-1001-project-setup/tasks.md", "source_location": null, "weight":