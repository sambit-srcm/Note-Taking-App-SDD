{"nodes": [{"id": "openspec_changes_ab_1001_project_setup_specs_service_health_spec_delta", "label": "Service Health Spec", "file_type": "document", "source_file": "openspec/changes/ab-1001-project-setup/specs/service-health/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives operators, developers, and tooling a cheap unauthenticated way to confirm the API process is up and serving requests."}, {"id": "openspec_changes_ab_1001_project_setup_specs_service_health_spec_liveness", "label": "Liveness Endpoint", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/specs/service-health/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /api/health responds 200 with JSON body status ok and a JSON content type while the process is serving requests."}, {"id": "openspec_changes_ab_1001_project_setup_specs_service_health_spec_public_minimal", "label": "Public Minimal Health Response", "file_type": "rationale", "source_file": "openspec/changes/ab-1001-project-setup/specs/service-health/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The endpoint does not require authentication, including when no Authorization header is sent, and the body contains only status. It does not expose version, environment, configuration, or database details."}, {"id": "openspec_changes_ab_1001_project_setup_specs_service_health_spec_db_independent", "label": "Database-Independent Health", "file_type": "rationale", "source_file": "openspec/changes/ab-1001-project-setup/specs/service-health/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The health endpoint does not query the database, so an unreachable PostgreSQL still returns 200 with status ok."}], "edges": [{"so