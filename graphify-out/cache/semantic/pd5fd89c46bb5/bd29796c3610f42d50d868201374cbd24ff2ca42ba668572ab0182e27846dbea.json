{"nodes": [{"id": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_delta", "label": "Runtime Configuration Spec", "file_type": "document", "source_file": "openspec/changes/ab-1001-project-setup/specs/runtime-configuration/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The API refuses to start with missing or invalid configuration and reports the problem without leaking secret values."}, {"id": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_startup_validation", "label": "Startup Environment Validation", "file_type": "rationale", "source_file": "openspec/changes/ab-1001-project-setup/specs/runtime-configuration/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NODE_ENV, PORT, and DATABASE_URL are validated before requests are accepted. A missing or invalid variable exits non-zero and opens no HTTP listener. A non-numeric PORT is invalid. Valid values listen on PORT."}, {"id": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_safe_reporting", "label": "Safe Configuration Error Reporting", "file_type": "rationale", "source_file": "openspec/changes/ab-1001-project-setup/specs/runtime-configuration/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Failure messages name the offending variable and the reason, missing or invalid, and must not print the variable value."}, {"id": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_env_example", "label": "Env Example and Gitignore", "file_type": "concept", "source_file": "openspec/changes/ab-1001-project-setup/specs/runtime-configuration/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".env.example lists every required variable with a non-secret placeholder. Real .env files are ignored by git. Copying the example and starting local PostgreSQL 16 is enough to pass configuration validation."}], "edges": [{"source": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_safe_reporting", "target": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_startup_validation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/ab-1001-project-setup/specs/runtime-configuration/spec.md", "source_location": null, "weight": 1.0}, {"source": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_env_example", "target": "openspec_changes_ab_1001_project_setup_specs_runtime_configuration_spec_startup_validation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "openspec/changes/ab-1001-project-setup/specs/runtime-configuration/spec.md", "source_location": null, "weight": 1.0}], "hyperedges": []}