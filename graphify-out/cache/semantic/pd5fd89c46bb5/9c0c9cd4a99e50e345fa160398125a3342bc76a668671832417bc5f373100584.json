{"nodes": [{"id": "docs_tickets_ab_1003_otp_password_reset", "label": "AB-1003 OTP Password Reset", "file_type": "document", "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-priority story for expiring single-use reset challenges and bounded verification attempts. Depends on AB-1001, AB-1002, and the approved password policy and reset API contract. Real email or SMS, frontend reset screens, support-assisted recovery, and login MFA are out of scope."}, {"id": "docs_tickets_ab_1003_otp_password_reset_challenge", "label": "Password Reset Challenge", "file_type": "concept", "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OTPs are stored in protected form, not plaintext, and are single-use. A successful reset consumes the challenge and stores the new password as a hash. Failures must not consume a challenge before the required work succeeds. Development console logging of OTPs must be off in production."}, {"id": "docs_tickets_ab_1003_otp_password_reset_attempt_limits", "label": "OTP Attempt and Resend Limits", "file_type": "concept", "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended defaults, pending approval: 10-minute expiry, at most 5 verification attempts, and a 60-second resend cooldown. Resend invalidates the previous OTP. Expired, incorrect, consumed, and invalidated OTPs are rejected. Rate limits apply by account and IP."}, {"id": "docs_tickets_ab_1003_otp_password_reset_account_privacy", "label": "Reset Account Privacy", "file_type": "concept", "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public reset responses do not reveal whether an email is registered, so the endpoint cannot be used to enumerate accounts."}, {"id": "docs_tickets_ab_1003_otp_password_reset_session_revocation", "label": "Reset Session Revocation", "file_type": "concept", "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After a successful password reset, session handling follows the approved policy. The recommended behavior is to revoke existing sessions so a previously stolen refresh token dies with the old password."}], "edges": [{"source": "docs_tickets_ab_1003_otp_password_reset", "target": "docs_tickets_ab_1001_project_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1003_otp_password_reset", "target": "docs_tickets_ab_1002_authentication", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1003_otp_password_reset_challenge", "target": "docs_tickets_ab_1003_otp_password_reset_attempt_limits", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1003_otp_password_reset_account_privacy", "target": "docs_tickets_ab_1003_otp_password_reset_challenge", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1003_otp_password_reset_session_revocation", "target": "docs_tickets_ab_1003_otp_password_reset_challenge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1003_otp_password_reset_session_revocation", "target": "docs_sds_refresh_token_session", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1003_otp_password_reset_challenge", "target": "docs_sds_password_reset_challenge", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}, {"source": "docs_tickets_ab_1003_otp_password_reset", "target": "docs_frs_otp_password_reset", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/tickets/AB-1003-otp-password-reset.md", "source_location": null, "weight": 1.0}], "hyperedges": []}